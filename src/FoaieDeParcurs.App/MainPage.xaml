<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FoaieDeParcurs.App.ViewModels"
             x:Class="FoaieDeParcurs.App.MainPage"
             x:DataType="vm:TrackingViewModel"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label
                Text="Foaie de Parcurs"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center" />

            <Label
                Text="Fill-up tracking lands in an upcoming ticket. For now, use this switch to control background GPS tracking."
                HorizontalTextAlignment="Center"
                TextColor="Gray" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,0">
                <Label Text="Background tracking" VerticalOptions="Center" FontAttributes="Bold" />
                <Switch Grid.Column="1" IsToggled="{Binding IsTracking, Mode=OneWay}" Toggled="OnTrackingToggled" />
            </Grid>

            <Label
                Text="{Binding StatusMessage}"
                TextColor="Gray"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

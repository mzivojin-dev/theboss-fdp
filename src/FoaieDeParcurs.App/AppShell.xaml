<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoaieDeParcurs.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoaieDeParcurs.App"
    xmlns:locations="clr-namespace:FoaieDeParcurs.App.Views.KnownLocations"
    Title="Foaie de Parcurs">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Locations"
            ContentTemplate="{DataTemplate locations:KnownLocationListPage}"
            Route="KnownLocations" />
    </TabBar>

</Shell>

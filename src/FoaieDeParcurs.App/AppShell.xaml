<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoaieDeParcurs.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:FoaieDeParcurs.App.Views.Dashboard"
    xmlns:locations="clr-namespace:FoaieDeParcurs.App.Views.KnownLocations"
    xmlns:settings="clr-namespace:FoaieDeParcurs.App.Views.Settings"
    Title="Foaie de Parcurs">

    <TabBar>
        <ShellContent
            Title="Acasă"
            ContentTemplate="{DataTemplate dashboard:DashboardPage}"
            Route="FillUps" />

        <ShellContent
            Title="Locații"
            ContentTemplate="{DataTemplate locations:KnownLocationListPage}"
            Route="KnownLocations" />

        <ShellContent
            Title="Setări"
            ContentTemplate="{DataTemplate settings:SettingsPage}"
            Route="Settings" />
    </TabBar>

</Shell>

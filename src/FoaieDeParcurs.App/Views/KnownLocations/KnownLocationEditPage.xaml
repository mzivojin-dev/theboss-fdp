<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoaieDeParcurs.App.Views.KnownLocations.KnownLocationEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FoaieDeParcurs.App.ViewModels.KnownLocations"
    x:DataType="vm:KnownLocationEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                Text="Caută adresa locației sau folosește poziția curentă. Coordonatele pot fi ajustate manual."
                FontSize="13"
                TextColor="Gray" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    Grid.Column="0"
                    Placeholder="Caută adresă (ex. Piața Victoriei, București)"
                    Text="{Binding SearchAddress}"
                    ReturnType="Search"
                    ReturnCommand="{Binding SearchAddressCommand}" />
                <Button Grid.Column="1" Text="Caută" Command="{Binding SearchAddressCommand}" />
            </Grid>

            <!--  Search feedback sits directly under the search box, where the problem is caused
                  and where the eye already is — not at the bottom of the form.  -->
            <Label
                Text="{Binding StatusMessage}"
                FontSize="13"
                TextColor="{Binding IsStatusError, Converter={StaticResource StatusColorConverter}}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Folosește poziția curentă" Command="{Binding UseCurrentLocationCommand}" />

            <!--  Coordinates are shown (and editable) because without a map this is the only way
                  to see what was actually resolved, or to paste a pin copied from elsewhere.  -->
            <Label Text="Coordonate" FontAttributes="Bold" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Latitudine" FontSize="12" TextColor="Gray" />
                    <Entry Text="{Binding Latitude}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Longitudine" FontSize="12" TextColor="Gray" />
                    <Entry Text="{Binding Longitude}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Nume" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry Placeholder="ex. Depozit X" Text="{Binding Name}" />

            <Label Text="Tip" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding Type}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}" />

            <Label Text="Rază de asociere (metri)" FontAttributes="Bold" />
            <Entry Text="{Binding RadiusMeters}" Keyboard="Numeric" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,16,0,0">
                <Button Grid.Column="0" Text="Anulează" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Salvează" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" />
            </Grid>

            <Button
                Text="Șterge"
                TextColor="Red"
                BackgroundColor="Transparent"
                IsVisible="{Binding IsExistingLocation}"
                Command="{Binding DeleteCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

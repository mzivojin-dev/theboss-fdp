<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoaieDeParcurs.App.Views.KnownLocations.KnownLocationEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FoaieDeParcurs.App.ViewModels.KnownLocations"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:DataType="vm:KnownLocationEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Atinge harta pentru a plasa marcajul sau caută o adresă mai jos." FontSize="13" TextColor="Gray" />

            <maps:Map
                x:Name="LocationMap"
                HeightRequest="260"
                IsShowingUser="False" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    Grid.Column="0"
                    Placeholder="Caută adresă (ex. Piața Victoriei, București)"
                    Text="{Binding SearchAddress}" />
                <Button Grid.Column="1" Text="Caută" Command="{Binding SearchAddressCommand}" />
            </Grid>

            <Label Text="Nume" FontAttributes="Bold" />
            <Entry Placeholder="ex. Depozit X" Text="{Binding Name}" />

            <Label Text="Tip" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding Type}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}" />

            <Label Text="Rază de asociere (metri)" FontAttributes="Bold" />
            <Entry Text="{Binding RadiusMeters}" Keyboard="Numeric" />

            <Label Text="{Binding StatusMessage}" TextColor="Red" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,16,0,0">
                <Button Grid.Column="0" Text="Anulează" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Salvează" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" />
            </Grid>

            <Button
                Text="Șterge"
                TextColor="Red"
                BackgroundColor="Transparent"
                IsVisible="{Binding IsExistingLocation}"
                Command="{Binding DeleteCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

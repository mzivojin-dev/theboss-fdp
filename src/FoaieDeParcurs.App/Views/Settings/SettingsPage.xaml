<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoaieDeParcurs.App.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FoaieDeParcurs.App.ViewModels.Settings"
    x:DataType="vm:SettingsViewModel"
    Title="Setări">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Companie și șofer" FontAttributes="Bold" FontSize="18" Margin="0,0,0,4" />
            <Label Text="Denumire companie" />
            <Entry Text="{Binding CompanyName}" />
            <Label Text="CUI" />
            <Entry Text="{Binding Cui}" />
            <Label Text="Nume șofer" />
            <Entry Text="{Binding DriverName}" />

            <Label Text="Vehicul" FontAttributes="Bold" FontSize="18" Margin="0,16,0,4" />
            <Label Text="Număr înmatriculare" />
            <Entry Text="{Binding VehiclePlate}" />
            <Label Text="Marcă / model" />
            <Entry Text="{Binding VehicleMakeModel}" />
            <Label Text="Categorie (ex. M1)" />
            <Entry Text="{Binding VehicleCategory}" />
            <Label Text="Tip combustibil" />
            <Picker ItemsSource="{Binding AvailableFuelTypes}" SelectedItem="{Binding FuelType}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}" />
            <Label Text="Norma de consum declarată (L/100km)" />
            <Entry Text="{Binding FuelConsumptionNormPer100Km}" Keyboard="Numeric" />

            <Label Text="Raportare" FontAttributes="Bold" FontSize="18" Margin="0,16,0,4" />
            <Label Text="Periodicitate" />
            <Picker ItemsSource="{Binding AvailableCadences}" SelectedItem="{Binding ReportingCadence}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}" />

            <Label Text="Email" FontAttributes="Bold" FontSize="18" Margin="0,16,0,4" />
            <Label Text="Destinatar" />
            <Entry Text="{Binding EmailRecipient}" Keyboard="Email" />
            <Label Text="Șablon subiect" />
            <Entry Text="{Binding EmailSubjectTemplate}" />
            <Label Text="Șablon conținut" />
            <Editor Text="{Binding EmailBodyTemplate}" HeightRequest="100" AutoSize="TextChanges" />

            <Label Text="Hărți" FontAttributes="Bold" FontSize="18" Margin="0,16,0,4" />
            <Label Text="Cheie API Google Maps SDK (opțional — lăsați gol pentru lista offline de orașe)" FontSize="12" TextColor="Gray" />
            <Entry Text="{Binding GoogleMapsApiKey}" />

            <Label Text="Urmărire" FontAttributes="Bold" FontSize="18" Margin="0,16,0,4" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Urmărire GPS în fundal" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsTracking, Mode=OneWay}" Toggled="OnTrackingToggled" />
            </Grid>
            <Label
                Text="{Binding TrackingStatusMessage}"
                FontSize="12"
                TextColor="Gray"
                IsVisible="{Binding TrackingStatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button
                Text="Salvează"
                Margin="0,20,0,0"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                Command="{Binding SaveCommand}" />

            <Label
                Text="{Binding StatusMessage}"
                TextColor="Green"
                HorizontalOptions="Center"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

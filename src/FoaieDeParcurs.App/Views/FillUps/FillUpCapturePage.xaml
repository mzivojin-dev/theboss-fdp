<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FoaieDeParcurs.App.Views.FillUps.FillUpCapturePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FoaieDeParcurs.App.ViewModels.FillUps"
    xmlns:entities="clr-namespace:FoaieDeParcurs.Core.Entities;assembly=FoaieDeParcurs.Core"
    x:DataType="vm:FillUpCaptureViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Stație" FontAttributes="Bold" FontSize="18" />
            <Label Text="Locație cunoscută (opțional)" />
            <Picker
                ItemsSource="{Binding AvailableKnownLocations}"
                SelectedItem="{Binding SelectedKnownLocation}"
                ItemDisplayBinding="{Binding Name}"
                IsEnabled="{Binding CanEdit}" />
            <Label Text="Denumire stație" />
            <Entry Text="{Binding StationName}" IsEnabled="{Binding CanEdit}" />

            <Label Text="Combustibil" FontAttributes="Bold" FontSize="18" Margin="0,16,0,0" />
            <Label Text="Litri alimentați" />
            <Entry Text="{Binding LitersFilled}" Keyboard="Numeric" IsEnabled="{Binding CanEdit}" />
            <Label Text="Sumă plătită" />
            <Entry Text="{Binding AmountPaid}" Keyboard="Numeric" IsEnabled="{Binding CanEdit}" />
            <Label Text="Monedă" />
            <Entry Text="{Binding Currency}" IsEnabled="{Binding CanEdit}" />
            <Label Text="Kilometraj bord (opțional, km)" />
            <Entry Text="{Binding OdometerReading}" Keyboard="Numeric" IsEnabled="{Binding CanEdit}" />

            <Label Text="Poză bon fiscal" FontAttributes="Bold" FontSize="18" Margin="0,16,0,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding CanEdit}">
                <Button Grid.Column="0" Text="Fă o poză" Command="{Binding TakePhotoCommand}" />
                <Button Grid.Column="1" Text="Alege din galerie" Command="{Binding PickPhotoCommand}" />
            </Grid>
            <Image
                Source="{Binding ReceiptPhotoPath}"
                HeightRequest="160"
                Aspect="AspectFit"
                IsVisible="{Binding ReceiptPhotoPath, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="Segmente de traseu" FontAttributes="Bold" FontSize="18" Margin="0,16,0,0" />
            <!-- IsEnabled cascades to every descendant, including the CollectionView's item
                 templates — simpler and more reliable than a RelativeSource lookup through
                 virtualized item containers. -->
            <CollectionView ItemsSource="{Binding Segments}" IsEnabled="{Binding CanEdit}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:RouteSegment">
                        <Border Padding="10" Margin="0,4" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <Entry Grid.Column="0" Text="{Binding StartLocationName}" />
                                    <Label Grid.Column="1" Text="&#8594;" VerticalOptions="Center" Margin="8,0" />
                                    <Entry Grid.Column="2" Text="{Binding EndLocationName}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="Distanță (km):" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding DistanceKm}" Keyboard="Numeric" />
                                </Grid>
                                <Label FontSize="12" TextColor="Gray">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:g} &#8594; {1:g}">
                                            <Binding Path="StartTimestamp" />
                                            <Binding Path="EndTimestamp" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Observații (opțional)" FontAttributes="Bold" FontSize="18" Margin="0,16,0,0" />
            <Editor Text="{Binding Notes}" HeightRequest="80" AutoSize="TextChanges" IsEnabled="{Binding CanEdit}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,20,0,0" IsVisible="{Binding CanEdit}">
                <Button Grid.Column="0" Text="Anulează" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Salvează" BackgroundColor="{StaticResource Primary}" TextColor="White" Command="{Binding SaveCommand}" />
            </Grid>

            <Label
                Text="{Binding StatusMessage}"
                TextColor="Gray"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <VerticalStackLayout IsVisible="{Binding VerificationIssues.Count, Converter={StaticResource CountGreaterThanZeroConverter}}" Spacing="4" Margin="0,8,0,0">
                <Label Text="Verificarea a găsit probleme:" FontAttributes="Bold" TextColor="Red" />
                <CollectionView ItemsSource="{Binding VerificationIssues}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" TextColor="Red" FontSize="13" Margin="0,2" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Fill-Up Detail / PDF Preview (spec) — only for a saved fill-up being viewed. -->
            <VerticalStackLayout IsVisible="{Binding CanEdit, Converter={StaticResource InvertedBoolConverter}}" Spacing="8" Margin="0,20,0,0">
                <Label Text="Foaie de Parcurs" FontAttributes="Bold" FontSize="18" />

                <Label Text="{Binding IsVerified, Converter={StaticResource VerifiedStatusIconConverter}, StringFormat='{0} Verificat'}" />
                <Label Text="✉️ Email trimis" IsVisible="{Binding EmailSent}" TextColor="Green" />

                <Button Text="Regenerează PDF" Command="{Binding GeneratePdfCommand}" />
                <Button
                    Text="Verifică și trimite"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Command="{Binding VerifyAndEmailCommand}" />

                <Label
                    Text="{Binding PdfFilePath}"
                    FontSize="11"
                    TextColor="Gray"
                    IsVisible="{Binding PdfFilePath, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!--
		Android 11 (API 30) restricted package visibility: an app can no longer resolve another
		app's intents unless it declares them here first. Without these, PackageManager reports
		"no handler" even when Gmail (or a PDF viewer) is installed, so
		Email.Default.ComposeAsync throws FeatureNotSupportedException and
		Launcher.Default.OpenAsync silently fails. The app targets API 36, so this applies.

		Each entry below maps to a specific thing the app hands off to another app:
	-->
	<queries>
		<!-- Email compose with the PDF attached (single fill-up + Dashboard batch export). MAUI
		     uses ACTION_SEND / ACTION_SEND_MULTIPLE once attachments are present. -->
		<intent>
			<action android:name="android.intent.action.SEND" />
			<data android:mimeType="application/pdf" />
		</intent>
		<intent>
			<action android:name="android.intent.action.SEND_MULTIPLE" />
			<data android:mimeType="application/pdf" />
		</intent>
		<!-- Email compose with no attachment — MAUI falls back to ACTION_SENDTO mailto:, which is
		     also what its "is an email client even available?" pre-check resolves against. -->
		<intent>
			<action android:name="android.intent.action.SENDTO" />
			<data android:scheme="mailto" />
		</intent>
		<!-- Opening a generated Foaie de Parcurs in a PDF viewer ("Regenerează PDF" preview). -->
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:mimeType="application/pdf" />
		</intent>
	</queries>
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" />
	<!--
		The app deliberately uses no Google Maps SDK and therefore needs no Maps API key. Address
		lookup goes through Android's own system Geocoder, with the bundled offline Romanian city
		list as the fallback when there's no network. That geocoder call is the only network use
		in the app; everything else is on-device.
	-->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!--
		Location tracking. Deliberately NOT requesting ACCESS_BACKGROUND_LOCATION — the
		foreground service + persistent notification below covers "tracking while backgrounded"
		without the stricter Play Store background-location review (see spec).
	-->
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Receipt photo capture (New/Edit Fill-Up screen). -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
</manifest>